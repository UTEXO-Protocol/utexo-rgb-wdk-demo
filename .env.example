# RGB network: mainnet | testnet | regtest
EXPO_PUBLIC_RGB_NETWORK=regtest

# Electrum indexer URL. Use `tcp://localhost:50001` on the iOS simulator and
# `tcp://10.0.2.2:50001` on the Android emulator when running against the
# Docker regtest stack (rgb-lib-nodejs/rgb-lib/tests/docker-compose.yml).
EXPO_PUBLIC_RGB_INDEXER_URL=tcp://localhost:50001

# RGB proxy / transport endpoint.
EXPO_PUBLIC_RGB_TRANSPORT_ENDPOINT=rpc://localhost:3000/json-rpc

# Bitcoin (wdk-wallet-btc) config — same indexer as RGB is fine for regtest.
EXPO_PUBLIC_BTC_NETWORK=regtest
EXPO_PUBLIC_BTC_INDEXER_URL=tcp://localhost:50001
