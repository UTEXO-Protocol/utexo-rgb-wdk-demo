# Signet environment for node-demo E2E.
#
# Source this file (or copy to .env.signet and `export $(cat ...)`)
# before running `npm run test:e2e`. Renat's June 1 ask: "update demo
# to the new version and change it to signet". This config is the
# Signet counterpart of run.ts's regtest defaults.
#
# Endpoints are operated by UTEXO. Once they stabilize, this file
# becomes the canonical signet target for both the alpha demo and
# Yurii's manual testing.

# Wallet network. Drives the JsonSdkInitRequest passed to RLN.
WDK_NETWORK=signet

# Bitcoin Core / esplora — the public utexo signet endpoint. The
# bitcoind dependency is going away (Renat item 5, blocked on
# upstream); for now Signet still requires these.
BITCOIND_HOST=signet.bitcoin.utexo.com
BITCOIND_PORT=38332
BITCOIND_USER=signetuser
BITCOIND_PASS=set-from-1password

# Electrs / esplora indexer (any electrum-protocol endpoint).
INDEXER_URL=tcp://signet.electrum.utexo.com:50001

# RGB proxy endpoint.
PROXY_ENDPOINT=rpc://signet.proxy.utexo.com:3000/json-rpc

# Peer RLN node (the LSP's RLN). PEER_BASE_URL is the HTTP API for
# t20.peerNodeInfo etc; PEER_HOST_FOR_LN + PEER_LN_PORT are used
# inside the `pubkey@host:port` strings t21.connectPeer constructs.
PEER_BASE_URL=https://signet.peer.utexo.com
PEER_HOST_FOR_LN=signet.peer.utexo.com
PEER_LN_PORT=9735

# utexo-lsp HTTP base. t109 fails fast if unset, which cascades the
# LSP suite (t109–t116) to skip — useful for "non-LSP" runs.
LSP_BASE_URL=https://signet.lsp.utexo.com

# VSS cloud backup (optional). When set, the manager forwards vssUrl
# to RLN and t120.vssBackupReplication runs the row-count probe.
VSS_URL=https://signet.vss.utexo.com
